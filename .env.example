# --- Claude (storyboard generation) ---
# Leave unset to run in mock mode (canned storyboard, no API calls).
# ANTHROPIC_API_KEY=sk-ant-...
# Force a mode regardless of key presence: "live" | "mock"
# AI_MODE=live
# Model used for storyboard planning
# CLAUDE_MODEL=claude-opus-5

# --- Images (per-shot storyboard frames) ---
# "mock" renders labeled SVG placeholder frames so the UI works with no keys.
# Add a real adapter in server/images/ and register it in server/images/index.ts.
# IMAGE_PROVIDER=mock

# --- Server ---
# PORT=8787
